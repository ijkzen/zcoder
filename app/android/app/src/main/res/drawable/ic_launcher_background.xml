<?xml version="1.0" encoding="utf-8"?>
<!-- Background layer of the adaptive launcher icon: near-black with a subtle
     diagonal lift so the mask cut has visible depth. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#1B1B21"
        android:centerColor="#0E0E12"
        android:endColor="#050507"
        android:type="linear" />
</shape>
